+if [[ "$CANARY_CAPACITY_MODE" == closed-loop ]]; then
+  # Preserve the historical per-benchmark repetition order and metric names.
+  rtk proxy timeout --kill-after=5s 46m go test ./internal/workflows -run '^$' -bench "$benchmark" \
+    -benchtime=1x -count="${CANARY_CAPACITY_COUNT:-10}" -timeout=45m -benchmem > "$output/raw.txt" 2>&1
+else
+  # Each scheduled invocation retains its own complete operations and deliveries.
+  for ((sample=1; sample<=${CANARY_CAPACITY_COUNT:-10}; sample++)); do
+    export CANARY_CAPACITY_RESULT_DIR="$output/sample-$sample"
+    mkdir "$CANARY_CAPACITY_RESULT_DIR"
